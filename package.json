{
  "name": "gripeventsctl-workspace",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "clean": "turbo run clean",
    "build": "turbo run build",
    "test": "turbo run test && pnpm test:scripts",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "turbo run test:e2e --concurrency=1",
    "test:oracles": "vitest run --config vitest.oracles.config.ts",
    "test:scripts": "vitest run --project scripts",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "typecheck": "turbo run typecheck",
    "lint": "pnpm format:check && turbo run lint && pnpm lint:root && pnpm check-secret-leakage && pnpm check-dep-confusion && pnpm check-test-traceability && pnpm check-api-docs-dated && pnpm check-workflow-pins && pnpm check-readme-posture",
    "lint:root": "eslint eslint.config.js vitest.config.ts vitest.e2e.config.ts vitest.oracles.config.ts scripts/",
    "license-check": "node scripts/check-licenses.js",
    "check-secret-leakage": "tsx scripts/check-secret-leakage.ts",
    "check-dep-confusion": "tsx scripts/check-dep-confusion.ts",
    "check-oracles": "tsx scripts/check-oracles.ts",
    "check-test-traceability": "tsx scripts/check-test-traceability.ts",
    "check-api-docs-dated": "tsx scripts/check-api-docs-dated.ts",
    "check-workflow-pins": "tsx scripts/check-workflow-pins.ts",
    "check-readme-posture": "tsx scripts/check-readme-posture.ts",
    "dev": "turbo run dev"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@tony.ganchev/eslint-plugin-header": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "prettier": "catalog:",
    "tsx": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:"
  }
}
