{
  "name": "@gripeventsctl/testing",
  "version": "0.0.0",
  "description": "Test helpers shared by the GripEventsCtl packages: a temporary home, a stub 1Password CLI, a manual clock, per-run fixture secrets, and the mock Grip API with its envelope builders",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "AGPL-3.0-only",
  "author": "Alexey Pelykh (https://github.com/alexey-pelykh)",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./setup": {
      "types": "./dist/setup.d.ts",
      "import": "./dist/setup.js"
    }
  },
  "scripts": {
    "clean": "rm -rf dist *.tsbuildinfo",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src/",
    "dev": "tsc --watch"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "undici": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:"
  }
}
